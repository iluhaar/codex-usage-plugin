{
  "name": "@illiadotdev/codex-usage-plugin",
  "version": "1.0.1",
  "license": "MIT",
  "description": "OpenCode plugin for viewing Codex ChatGPT usage limits and credits.",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iluhaar/codex-usage-plugin.git"
  },
  "homepage": "https://github.com/iluhaar/codex-usage-plugin#readme",
  "bugs": {
    "url": "https://github.com/iluhaar/codex-usage-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "codex-usage-plugin": "dist/bin/codex-usage-plugin.js"
  },
  "keywords": [
    "opencode",
    "codex",
    "plugin",
    "quota",
    "tui"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "install-plugin": "npm run build && node dist/bin/codex-usage-plugin.js --install",
    "uninstall-plugin": "node dist/bin/codex-usage-plugin.js --uninstall",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/plugin.test.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.32"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "^2.0.32",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/node": "^24.0.0",
    "oxlint": "^1.0.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.3"
  }
}
